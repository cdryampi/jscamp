{
  "version": 2,
  "rewrites": [
    { "source": "/api/eventos/categorias", "destination": "/api/categorias" },
    { "source": "/api/eventos/ubicaciones", "destination": "/api/ubicaciones" },
    { "source": "/api/eventos", "destination": "/api/eventos" },
    { "source": "/", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
